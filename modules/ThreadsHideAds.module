#!name=ThreadsHideAds
#!desc=Threads / Instagram 信息流内置广告拦截（GraphQL + API 双通道，语义化识别）
#!author=darveydev
#!arguments=启用调试模式:false, 仅处理信息流:true, 同时屏蔽推荐内容:false
#!arguments-desc=\n▶ 参数说明：\n\n- 启用调试模式：在 Surge 日志中输出命中的 URL 与删除条数，排查问题时打开，默认关闭。\n- 仅处理信息流：开启后只处理白名单内的信息流接口，避免影响登录、评论、消息、上传等请求。强烈建议保持开启。\n- 同时屏蔽推荐内容：在广告之外，额外移除 netego（推荐用户 / 推荐帖子 / 探索卡片）等非广告插入内容，默认关闭。\n\n⚠️ 首次使用需安装并信任 Surge 的 MITM 根证书，否则无法解密 HTTPS 内容。

[Script]
# ─────────────────────────────────────────────────────────────────────────────
# 脚本位置：与本 .module 文件放在同一目录（Surge 配置目录）即可直接生效。
# 若使用远程托管，把 script-path 换成 raw 链接，例如：
#   script-path=https://raw.githubusercontent.com/<user>/<repo>/main/ThreadsHideAds.js
# ─────────────────────────────────────────────────────────────────────────────

# Threads：网页版 /api/graphql、/graphql/query，App 版 /api/v1/text_post_app_timeline
threads.ads.response = type=http-response,pattern=^https:\/\/(?:www\.)?threads\.net\/(?:api\/graphql|graphql|api\/v1\/),requires-body=true,max-size=0,script-path=https://raw.githubusercontent.com/darveydev/VPN-Private-Config/refs/heads/main/modules/ThreadsHideAds.js,argument={"debug":{{{启用调试模式}}},"feedOnly":{{{仅处理信息流}}},"blockSuggested":{{{同时屏蔽推荐内容}}}

# Instagram：网页版 /graphql/query、App 版 /api/v1/feed、Reels、探索页
instagram.ads.response = type=http-response,pattern=^https:\/\/(?:www\.|i\.|b\.i\.|graph\.)?instagram\.com\/(?:api\/v1\/(?:feed|clips|discover|explore|loops)|graphql|api\/graphql),requires-body=true,max-size=0,script-path=https://raw.githubusercontent.com/darveydev/VPN-Private-Config/refs/heads/main/modules/ThreadsHideAds.js,argument={"debug":{{{启用调试模式}}},"feedOnly":{{{仅处理信息流}}},"blockSuggested":{{{同时屏蔽推荐内容}}}

[MITM]
hostname = %APPEND% threads.net, www.threads.net, instagram.com, www.instagram.com, i.instagram.com, b.i.instagram.com, graph.instagram.com
